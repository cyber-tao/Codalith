---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const chinese = Astro.url.pathname.includes('/zh-cn/');
---
<a class="site-title" href={`${base}/${chinese ? 'zh-cn/' : ''}`} aria-label="Codalith">
  <img src={`${base}/brand/codalith-mark.png`} width="38" height="38" alt="" />
  <span>Codalith</span>
  <span class="version">0.2</span>
</a>
<style>
  .site-title { display: flex; align-items: center; gap: .55rem; color: var(--sl-color-white); text-decoration: none; font-size: 1.28rem; font-weight: 700; letter-spacing: -.05em; }
  img { object-fit: contain; background: #edf4ef; border-radius: 6px; }
  .version { align-self: center; font-size: .66rem; border: 1px solid var(--sl-color-hairline); border-radius: 4px; padding: .1rem .32rem; letter-spacing: 0; font-weight: 500; }
</style>
