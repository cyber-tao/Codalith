{
  "name": "@codalith/website",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "prepare": "node scripts/sync-docs.mjs && node scripts/sync-brand.mjs",
    "dev": "bun run prepare && astro dev --host 127.0.0.1",
    "check": "bun run prepare && astro check",
    "build": "bun run prepare && astro build",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
}
